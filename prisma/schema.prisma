generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Request {
  id          String   @id @default(cuid())
  name        String
  phone       String
  deviceType  String
  deviceModel String?
  issue       String
  status      String   @default("new")
  createdAt   DateTime @default(now())
}
